# Koyeb doesn't run docker-compose.yml natively — each Koyeb Service is one
# container. This wraps `docker compose up` itself in a single privileged
# container (Koyeb's documented pattern: https://github.com/koyeb/koyeb-docker-compose)
# so the existing web + invidious_companion 2-service setup can run inside
# Koyeb's single free instance, instead of needing two paid services.
#
# Requires the "Privileged" flag enabled on the Koyeb Service (lets the
# nested Docker daemon run) and the exposed port set to 3000.
#
# web's image is NOT built here — this container has only 512MB RAM / 0.1
# vCPU, nowhere near enough to `bun install && next build` on a cold start.
# Instead .github/workflows/build-web-image.yml prebuilds and pushes it to
# GHCR, and docker-compose.koyeb.yml just pulls it. Keep that image PUBLIC on
# GHCR (Settings > Package > Change visibility) — no secrets are baked into
# it (see .dockerignore), so this is safe, and it avoids setting up a
# registry pull secret on Koyeb.
FROM koyeb/docker-compose

COPY docker-compose.koyeb.yml /app/docker-compose.koyeb.yml

CMD ["docker", "compose", "-f", "docker-compose.koyeb.yml", "up"]
