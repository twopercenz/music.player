# --- Password gate (middleware.ts / lib/auth.ts) ---
# The one password that gets you into the app. No accounts, just this.
SITE_PASSWORD=
# Random secret used to sign the session cookie. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=

# --- yt-dlp cookies (see lib/extract.ts) ---
# YouTube increasingly blocks extraction from datacenter IPs with "Sign in to
# confirm you're not a bot" — cookies from a real logged-in session fix it.
# Path to an exported cookies.txt file (Netscape format) — not its contents.
# Locally: e.g. ./cookies.txt (gitignored — never commit this file, it's a
# real login session). On Render: upload it as a Secret File and put its
# mount path here (e.g. /etc/secrets/cookies.txt). See README for details.
YTDLP_COOKIES_FILE=
# Local dev only — pulls cookies straight from an installed browser instead
# (chrome, firefox, edge, ...). Leave YTDLP_COOKIES_FILE unset to use this.
YTDLP_COOKIES_FROM_BROWSER=

# --- YouTube Data API (matching only — search itself is iTunes, see lib/itunes.ts) ---
# Create a key at https://console.cloud.google.com/apis/credentials with the
# YouTube Data API v3 enabled. This key is used only by /api/resolve
# (lib/youtube.ts) to find the actual playable video for a search result the
# user picked — search results are NOT the playable video directly.
#
# Quota warning: search.list (100 units) + videos.list (1 unit) per resolve
# call means the free 10k units/day quota is gone after ~99 resolves/day.
#
# (Spotify search was dropped — as of March 2026 it requires the developer
# account to have an active Premium subscription. Search now hits Apple's
# free iTunes Search API instead, which needs no key.)
YOUTUBE_API_KEY=

# --- Supabase (shared library sync only — see lib/supabase.ts) ---
# Free tier project: https://supabase.com/dashboard — run supabase/schema.sql once.
# Dashboard > Settings > API Keys > use the SECRET key (sb_secret_..., replaces
# the old service_role key) — never the publishable key, and only ever used
# server-side here.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
