# --- Password gate (middleware.ts / lib/auth.ts) ---
# The one password that gets you into the app. No accounts, just this.
SITE_PASSWORD=
# Random secret used to sign the session cookie. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=

# --- Invidious Companion (audio extraction — see lib/companion.ts) ---
# Resolves and proxies the actual YouTube audio stream, replacing the old
# in-process yt-dlp + ffmpeg pipeline — see docker-compose.yml and
# https://github.com/iv-org/invidious-companion/wiki. Must be exactly 16
# alphanumeric characters, and must match the invidious_companion service's
# SERVER_SECRET_KEY in docker-compose.yml (same value, different var name —
# this is the Bearer token `web` sends, Companion validates it against its
# own copy). Generate one with: openssl rand -hex 8
COMPANION_SECRET_KEY=
# Base URL of the Companion service. The docker-compose.yml default
# (http://invidious_companion:8282) only resolves inside that network — for
# local dev without Docker Compose, run Companion separately (see its repo)
# and point this at wherever it's listening instead.
COMPANION_URL=http://invidious_companion:8282

# --- YouTube Data API (matching only — search itself is iTunes, see lib/itunes.ts) ---
# Create a key at https://console.cloud.google.com/apis/credentials with the
# YouTube Data API v3 enabled. This key is used only by /api/resolve
# (lib/youtube.ts) to find the actual playable video for a search result the
# user picked — search results are NOT the playable video directly.
#
# Quota warning: search.list (100 units) + videos.list (1 unit) per resolve
# call means the free 10k units/day quota is gone after ~99 resolves/day.
# Once a (artist, title, duration) combo has been resolved, the videoId is
# cached in Supabase (resolve_cache table — see lib/resolve-cache.ts) so
# repeat resolves of the same track don't hit this API again.
#
# (Spotify search was dropped — as of March 2026 it requires the developer
# account to have an active Premium subscription. Search now hits Apple's
# free iTunes Search API instead, which needs no key.)
YOUTUBE_API_KEY=

# --- Supabase (shared library sync only — see lib/supabase.ts) ---
# Free tier project: https://supabase.com/dashboard — run supabase/schema.sql once.
# Dashboard > Settings > API Keys > use the SECRET key (sb_secret_..., replaces
# the old service_role key) — never the publishable key, and only ever used
# server-side here.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
