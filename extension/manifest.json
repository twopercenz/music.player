{
  "manifest_version": 3,
  "name": "music.player Companion",
  "version": "1.0.0",
  "description": "Resolves YouTube audio streams for music.player from inside your own browser session, so no server ever has to talk to YouTube directly.",
  "key": "",
  "permissions": ["tabs"],
  "host_permissions": ["*://*.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/watch*"],
      "js": ["content-script.js"],
      "run_at": "document_end"
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "https://mxc-play.kro.kr/*",
      "http://mxc-play.kro.kr/*",
      "http://mxc-play.kro.kr:3000/*"
    ]
  }
}
